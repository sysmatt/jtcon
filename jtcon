def _freq_to_band(hz: int) -> str | None:
    """Convert a dial frequency in Hz to an ADIF band string, or None."""
    if   1_800_000 <= hz <  2_000_000: return "160m"
    elif 3_500_000 <= hz <  4_000_000: return "80m"
    elif 7_000_000 <= hz <  7_300_000: return "40m"
    elif 14_000_000 <= hz < 14_350_000: return "20m"
    elif 18_068_000 <= hz < 18_168_000: return "17m"
    elif 21_000_000 <= hz < 21_450_000: return "15m"
    elif 24_890_000 <= hz < 24_990_000: return "12m"
    elif 28_000_000 <= hz < 29_700_000: return "10m"
    return None

