def download_cty(path: Path) -> None:
    req = urllib.request.Request(
        CTY_DAT_URL, headers={"User-Agent": "jtcon/2.0"}
    )
    with urllib.request.urlopen(req, timeout=20) as resp:
        data = resp.read()
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_bytes(data)
    tmp.replace(path)


